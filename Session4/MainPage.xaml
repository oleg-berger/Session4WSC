<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Session4.MainPage">

   <Grid RowDefinitions="auto, auto, *" Margin="20,0">
       <HorizontalStackLayout 
           Spacing="22"
           Margin="-20,0"
           Grid.Row="0">
                <Button 
                    Text="Purchase Order Management"
                    HeightRequest="5"
                    BackgroundColor="Transparent"
                    TextColor="Blue"
                    x:Name="OM"
                    Clicked="OM_OnClicked">
                </Button>
                <Button 
                    Text="Warehouse Management"
                    HeightRequest="5"
                    BackgroundColor="Transparent"
                    TextColor="Blue"
                    x:Name="WM"
                    Clicked="WM_OnClicked">
                </Button>
               <Button
                   Text="Inventory Report"
                   HeightRequest="5"
                   BackgroundColor="Transparent"
                   TextColor="Blue"
                   x:Name="IR"
                   Clicked="IR_OnClicked">
               </Button>
             
       </HorizontalStackLayout>
        <Grid Grid.Row="1" 
              ColumnDefinitions="*, *, *, *, *, *, *"
             >
            <Label
                Text="Part Name"
                FontAttributes="Bold"
                Grid.Column="0"
                BackgroundColor="#F0F0F0"></Label>
            <Label
                Text="Transaction Type"
                FontAttributes="Bold"
                Grid.Column="1"
                BackgroundColor="#F0F0F0"></Label>
            <Label
                Text="Date"
                FontAttributes="Bold"
                Grid.Column="2"
                BackgroundColor="#F0F0F0"></Label>
            <Label
                Text="Amount"
                FontAttributes="Bold"
                Grid.Column="3"
                BackgroundColor="#F0F0F0"></Label>
            <Label
                Text="Source"
                FontAttributes="Bold"
                Grid.Column="4"
                BackgroundColor="#F0F0F0"></Label>
            <Label
                Text="Destination"
                FontAttributes="Bold"
                Grid.Column="5"
                BackgroundColor="#F0F0F0"></Label>
            <Label
                Text="Actions"
                FontAttributes="Bold"
                Grid.Column="6"
                BackgroundColor="#F0F0F0"></Label>
            
        </Grid>
        <CollectionView Grid.Row="2" x:Name="ListOrders">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*, *, *, *, *, *, *"
                          ColumnSpacing="20"
                          >
                        <Label Grid.Column="0" Text="{Binding PartName}"></Label>
                        <Label Grid.Column="1" Text="{Binding TransactionType}"></Label>
                        <Label Grid.Column="2" Text="{Binding Date}"></Label>
                        <Label Grid.Column="3" Text="{Binding Amount}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding TransactionTypeID}"
                                    Value="1">
                                    <Setter Property="BackgroundColor" Value="#d4edda"/>
                                </DataTrigger>
                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding TransactionTypeID}"
                                    Value="2">
                                    <Setter Property="BackgroundColor"
                                            Value="#cce5ff"></Setter>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="4" Text="{Binding Supplier}"></Label>
                        <Label Grid.Column="5" Text="{Binding DestinationWarehouse}"></Label>
                        <FlexLayout Grid.Column="6"
                                    JustifyContent="SpaceBetween">
                            <Button 
                            Text="Edit " 
                            BackgroundColor="Transparent" 
                            TextColor="Blue"
                            x:Name="EditButton"
                            Clicked="EditButton_OnClicked"
                            CommandParameter="{Binding .}"
                            ></Button>
                            <Button
                            Text="Remove" 
                            BackgroundColor="Transparent" 
                            TextColor="Blue"
                            x:Name="RemoveButton"
                            Clicked="RemoveButton_OnClicked"
                            CommandParameter="{Binding .}"
                           ></Button>
                        </FlexLayout>
                        
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
   </Grid>

</ContentPage>
